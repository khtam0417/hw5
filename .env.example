# Copy this file to .env and fill in your own values. Never commit or share the real .env.

# How the agents sign in to Claude (through the Claude Agent SDK), the same setup as Homework 4.
# Set ONE of these.
# 1. A Claude subscription token: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token-here
# 2. Or an Anthropic API key from https://console.anthropic.com (used only if no token is set above).
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Course Portkey key. Not used: the agents call Claude with the sign-in above, so this stays a placeholder.
# PORTKEY_API_KEY=your-portkey-api-key-here
